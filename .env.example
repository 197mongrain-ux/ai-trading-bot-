# Trading mode: paper (default) | live
TRADING_MODE=paper

# LIVE gate — must be exactly "true" in addition to TRADING_MODE=live
I_UNDERSTAND_LIVE_TRADING=false

# Kill switch: set to 1 to flatten and halt (also works via .killswitch file)
KILL_SWITCH=0

# Hyperliquid network
HL_NETWORK=mainnet
# HL_API_URL=https://api.hyperliquid.xyz
# HL_API_URL=https://api.hyperliquid-testnet.xyz

# API wallet (agent) — NEVER commit real keys
# Create an API wallet at https://app.hyperliquid.xyz/API
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# Symbols — Hyperliquid perp coin names (bare: BTC, SOL, XRP)
# SYMBOLS takes precedence (comma-separated). SYMBOL is single-symbol fallback.
SYMBOLS=BTC,SOL,XRP
# SYMBOL=BTC

# Stacking: max independent opens on the SAME ticker (each with own stop/tp/size).
# Default 3. 0 = unlimited per symbol (still bound by account risk limits).
MAX_POSITIONS_PER_SYMBOL=3

# Optional GLOBAL cap across all symbols / trade_ids. 0 = unlimited (default).
# Example: MAX_OPEN_POSITIONS=9 to allow 3 symbols × 3 stacks.
MAX_OPEN_POSITIONS=0

# Strategy / risk
STARTING_EQUITY=5000
# Scalp default 0.5%. ENTRY_MODE=model_b requires 0.02
# (max 2% of spot USDC, not perp account value).
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.08
# 0 = unlimited daily trade count (default). Set e.g. 500 to hard-cap.
# Strategy signals + daily loss / DD / consecutive-loss still limit activity.
MAX_TRADES_PER_DAY=0
MAX_CONSECUTIVE_LOSSES=3
# Leverage is exchange margin setting (efficiency for tiny stops), NOT position sizing.
# Size always = dollar_risk / stop_distance. Cap notional at equity * LEVERAGE.
LEVERAGE=20
TP_R_MULTIPLE=2.0

# Scalp: fixed % stop from entry (NOT at VWAP). 0.0015 = 0.15%
STOP_PCT=0.0015
# Prior N completed 1m bars for breakout high/low
BREAKOUT_BARS=3
# Optional floor / ceiling on stop distance as fraction of entry
# MIN_STOP_PCT=0
# MAX_STOP_PCT=

# VWAP_BUFFER_BPS is BIAS-ONLY (long if mark > VWAP+buf; short if mark < VWAP-buf).
# Default 0. Optional small buffer e.g. 2 bps. Does NOT place the stop.
VWAP_BUFFER_BPS=0
VWAP_RESET_UTC_HOUR=0
LOOP_INTERVAL_SEC=5
# STOP_BUFFER_BPS is deprecated (old stop-at-VWAP); ignored by strategy
# STOP_BUFFER_BPS=0

# Journal
JOURNAL_PATH=logs/trades.jsonl

# --- Accuracy filters (gate new entries before open) ---
# 1) Volatility / noise vs stop: skip if avg (high-low)/close over lookback
#    >= MAX_RANGE_VS_STOP × STOP_PCT (default 1.0 → bar noise ≥ stop → skip).
MAX_RANGE_VS_STOP=1.0
VOL_LOOKBACK_BARS=5
# Optional: skip if last 1m bar range > this (0.003 = 0.3%). Empty = disable.
MAX_BAR_RANGE_PCT=0.003

# 2) Session / time-of-day (UTC). START-END, start inclusive, end exclusive.
#    12-23 = 12:00–22:59 UTC (liquid crypto hours). Empty or 0-24 = disable.
TRADE_HOURS_UTC=12-23

# 3) Higher-timeframe confirmation: long only above HTF session VWAP, short below.
HTF_CONFIRM=true
HTF_INTERVAL=5m

# After a stop-out on a symbol, block new entries for this many seconds.
ENTRY_COOLDOWN_SEC=120

# Restarting `hl_bot run` always clears in-memory daily halt. Set 1 to also
# journal a risk_reset event at process start.
# RESET_DAILY_RISK=0

# --- Entry mode / OTE pullback add-on ---
# breakout | ote | both (default) | model_b
# both: prefer OTE when mark is in the 62–79% Fib zone of the latest
# impulse (with VWAP bias); else breakout.
# model_b desk start (testnet live). Paper is for unit tests only.
# TRADING_MODE=live
# HL_NETWORK=testnet
# ENTRY_MODE=model_b
# Hunt list. Unset SYMBOLS uses the built-in mainnet universe in both
# NY and after hours (majors first, then xyz:GOLD, xyz:SP500, xyz:XYZ100).
# xyz:XYZ100 is the Nasdaq proxy. The dex prefix stays lowercase.
# SYMBOLS=BTC,ETH,SOL,NEAR,PUMP,LIT,AAVE,ONDO,WLD,TAO,xyz:GOLD,xyz:SP500,xyz:XYZ100
# LEVERAGE=20
# RISK_PER_TRADE=0.02
# HL_ACCOUNT_ADDRESS=0x...   # master account; spot USDC total is the risk base
# Another ticker may rest beside an unfilled Alo when that same balance
# still covers the new ticket's initial margin (notional / the coin's max
# leverage) at full 2% size. Unknown meta uses 20×. LEVERAGE stays 20;
# that env is not the per-coin margin. The exchange leverage set before
# each Alo is still the coin max (margin = notional / coin max).
# MODEL_B_MAX_LEVERAGE is the size brake: ticket notional never exceeds
# that many times spot USDC (default 20; unset / 0 keeps 20).
# MODEL_B_MIN_STOP_BPS (default 15) sizes from at least that stop distance
# when the liquidity stop is tighter. The stop price itself stays put.
# Neither moves the stop, the target, or raises risk above 2%.
# MODEL_B_MAX_LEVERAGE=20
# MODEL_B_MIN_STOP_BPS=15
# A liquidity stop tighter than MODEL_B_MIN_STOP_BPS is moved out to the
# next confirmed swing / untaken pool past that distance (plus the usual
# buffer); TP must then be a pool at >= MODEL_B_TP_R, else STOP_TOO_TIGHT.
# Entry filters: STRUCTURE (no long into 15m/1h LH+LL, no short into HH+HL),
# COUNTER_FLOW (most adverse rolling 90s delta in the last N s, band =
# max(USDC/mid, EPS coins); passes only if flipped >= FLIP x and held),
# SHALLOW_SWEEP (bps past the swing; number or BTC:5,default:0.3).
# MODEL_B_STRUCTURE_FILTER=1   # 1/on = gate, shadow = log "MODEL_B SHADOW reason=STRUCTURE would_block=1" only, 0 = off
# MODEL_B_COUNTER_FLOW=1
# MODEL_B_COUNTER_FLOW_SEC=300
# MODEL_B_COUNTER_FLOW_USDC=1000000
# MODEL_B_COUNTER_FLOW_EPS=0
# MODEL_B_COUNTER_FLOW_FLIP=1.0
# MODEL_B_COUNTER_FLOW_HOLD_SEC=30
# MODEL_B_MIN_SWEEP_BPS=0.3
# MODEL_B_SWEEP_REQUIRE_HTF=0
# Two-sided hunt (default 1): each cycle evaluates BOTH the long setup
# (sweep below a swing low -> reclaim) and the short setup (sweep above a
# swing high -> reclaim back below) on every coin, with the same gates,
# SL/TP placement, 1.67R floor, min stop, 2% sizing and 20x cap. The
# nearest draw pool is only that side's TP target. If both sides arm, the
# side matching 15m/1h structure wins, then higher absorb. One ticket per
# coin. Logs one FAIL line per side: "MODEL_B FAIL BTC side=short ...".
# 0 = old behaviour (nearest pool alone picks the side). Rollback = 0.
# MODEL_B_TWO_SIDED=1
# TP next pool (default 1.5): the TP is the nearest liquidity (confirmed
# swing / untaken pool) past 1R + fees. If that nearest level is under
# this R (same fee/R math), the TP walks out to the first real level at or
# past it (no 2R cap on liquidity, as before). If none exists, the nearest
# is kept and "MODEL_B TP_UNDER_1_5R <coin> <side> r=.." is logged. The
# min-stop widened case keeps its MODEL_B_TP_R pool floor. Stops, size,
# leverage, margin caps, gates and the guard do not change.
# 0 = old behaviour exactly (no trend read, no skip, no new log). Rollback = 0.
# MODEL_B_TP_MIN_POOL_R=1.5
# Too far: a walked-to pool past MODEL_B_TP_MAX_POOL_R (default 3; there is
# no older pool cap, liquidity was always kept past 2R) is kept only when the
# side is WITH the 15m/1h trend; same for "no pool >= 1.5R" (nearest kept).
# Not with trend (counter or range) -> skip: TP_TOO_FAR_COUNTERTREND /
# TP_UNDER_1_5R_COUNTERTREND. Trend = 5-bar fractal swings on 15m and 1h,
# last 2 highs AND lows rising (up) / falling (down), downgraded to range on a
# closed candle through the last swing; with trend = one TF agrees and none
# opposes. Logged: "MODEL_B TREND <coin> 15m=.. 1h=.. ema50_1h=.. with_side=..".
# MODEL_B_TP_FAR_SKIP_COUNTERTREND=0 keeps the far / near pool instead of skipping.
# MODEL_B_TP_MAX_POOL_R=3
# MODEL_B_TP_FAR_SKIP_COUNTERTREND=1
# Better TP targeting. Untaken (default 1) ignores 1m swings price has
# already traded through. Refresh (default 1) re-picks the TP at the fill
# when that planned level was traded through while the Alo rested; the
# stop and the size stay, and a failed re-pick keeps the planned TP.
# Runner (default shadow) logs a 50% partial: TP1 at the normal target,
# the rest at the next significant untaken pool (5m/15m swing, equal
# highs/lows, or PDH/PDL/WKH/WKL) between max(TP1_R+1, 2.5R) and
# MODEL_B_TP_RUNNER_MAX_R, else that max R. shadow changes no order.
# 1 places two reduce-only TPs, keeps a full-size stop the whole time,
# and after TP1 moves that stop to breakeven then trails it behind the
# latest confirmed 1m swing (never looser). 0 on all three is PR #14.
# Size, leverage, and margin are unchanged.
# MODEL_B_TP_UNTAKEN_ONLY=1
# MODEL_B_TP_REFRESH_ON_FILL=1
# MODEL_B_TP_RUNNER=shadow
# MODEL_B_TP_RUNNER_FRAC=0.5
# MODEL_B_TP_RUNNER_MAX_R=5
# Macro side filter (default shadow). Trend id = ADX(14, Wilder) with +DI/-DI
# on 1h and 4h (1h candles fetched ~40 days, cached; 4h resampled). A TF is
# up when ADX >= MODEL_B_MACRO_ADX_MIN and +DI > -DI, down when -DI > +DI,
# else range. MODEL_B_MACRO_MODE: 4h_lead (4h trending, 1h not trending
# against) | both | 4h_only | 4h_lead_1h_fill. macro up -> longs only, down ->
# shorts only, range -> MODEL_B_MACRO_RANGE_POLICY (both = trade both, none =
# no trade). 1 = block (FAIL reason=MACRO_SIDE), shadow = log
# "MODEL_B SHADOW <coin> reason=MACRO_SIDE would_block=1" on arms it would
# block, 0 = off (old behaviour exactly). Logged once per coin per 1h bar:
# "MODEL_B MACRO <coin> 1h=down(adx=.. +di=.. -di=..) 4h=.. macro=.. allowed=..".
# Stops, TP, size, leverage, margin caps and the guard do not change.
# MODEL_B_MACRO_SIDE_ONLY=shadow
# MODEL_B_MACRO_RANGE_POLICY=both
# MODEL_B_MACRO_ADX_MIN=20
# MODEL_B_MACRO_MODE=4h_lead
# Protection guard (every pass + its own thread): stop on every position
# (two tries, else NAKED_CLOSE), LOSS_KILL at N x planned risk (2% of spot
# if unknown), OVERSIZE_CUT above 20x or N x ticket. Each writes MODEL_B ALERT.
# MODEL_B_GUARD_SEC=3
# MODEL_B_LOSS_KILL_R=1.0
# MODEL_B_OVERSIZE_RATIO=1.1
# Hard rule: no open position may lose more than 2% of the account. Tickets
# are shrunk so loss at the stop <= cap; the guard puts a cap stop on every
# position and LOSS_KILLs at min(LOSS_KILL_R x planned risk, cap x account at
# open). Startup refuses anything above 0.02.
# MODEL_B_MAX_LOSS_PCT=0.02
# If it does not, Model B cancels the resting Alo when the new limit is
# strictly closer to a fill AND the new score is >= the resting score.
# Setup quality (default 1). Armed candidates in one pass are ranked by
# R to TP1, absorb, macro ADX alignment, stop vs ATR, sweep depth, and
# fee drag before margin is given out. The closer-ticker guard and the
# 60% reserve use that number (best = highest quality). shadow logs
# quality=... on the ARM line and keeps today's order. 0 is the density
# score (prints/10, cap 9) and SYMBOLS order. Not an arm gate. Size,
# leverage, and margin math do not change because of the rank.
# MODEL_B_QUALITY_RANK=1
# Per-coin fees in the 2% size and the TP fee floor (default 1). Main-dex
# coins stay on the account rate or 1.5/4.5 bps. xyz outside growth mode
# uses 2x (table 3.0/9.0 bps, above the observed 2.88/8.64), so a 15 bps
# GOLD stop is sized down until loss at the stop including fees is <= 2%.
# Growth-mode xyz uses 0.2x only when meta says so. 0 = base tier for every
# coin (the old size, which can lose ~2.5% on a tight xyz stop).
# MODEL_B_COIN_FEES=1
# Candles (default 1): one staggered full backfill at startup, then only
# the last few 1m bars merged into the cache. Guard/account reads are not
# deferred; candle tails wait when the rolling weight is near
# MODEL_B_WEIGHT_BUDGET (default 1000, under the 1,200/min cap).
# 0 refetches the full ~5,000-bar window every minute.
# MODEL_B_CANDLE_INCREMENTAL=1
# MODEL_B_WEIGHT_BUDGET=1000
# Total open risk and one name per correlated group. Default shadow: log
# MODEL_B RISK_CAP would_block and still post. 1 refuses the new ticket.
# 0 does not look. The cap counts fee-inclusive loss on open positions and
# resting tickets. Groups: crypto; US tech/semis; oil; metals.
# MODEL_B_RISK_CAP=shadow
# MODEL_B_MAX_TOTAL_RISK_PCT=6
# Isolated-only assets (xyz:SMSN) set isolated margin instead of failing
# the cross leverage update. Cross coins stay cross. 0 always asks for cross.
# Margin is still notional / leverage.
# MODEL_B_ISOLATED_MARGIN=1
# Stop-market slippage in the 2% size (default shadow). shadow logs
# MODEL_B STOP_SLIP would_size and posts today's size. 1 shrinks the
# size so loss at the trigger plus the allowance plus fees is <= 2%.
# 0 does not look. The stop price, the 2% cap, and the 20x cap stay.
# Empty bps: xyz names use 20 bps (above the Oct 8 SKHX 15 bp print),
# other names use 5 bps. A wider bid/ask raises the allowance.
# MODEL_B_STOP_SLIP=shadow
# MODEL_B_STOP_SLIP_BPS=
# Higher-timeframe stop check (default shadow). Logs when the liquidity
# stop is not beyond the nearest 15m swing plus the usual buffer
# (SKHX: 1198.8 sat one tick under the 1198.9 15m high). shadow does
# not move the stop. 1 places it beyond that swing and sizes from the
# wider distance. 0 does not look.
# MODEL_B_HTF_STOP=shadow
# Swing Model B. Default scalp is unchanged. Swing papers against live
# mainnet prices until MODEL_B_PAPER=0 (that is the live opt-in, and it
# still needs TRADING_MODE=live and I_UNDERSTAND_LIVE_TRADING=true).
# Journal is logs/model_b_swing_paper.jsonl unless MODEL_B_JOURNAL_PATH is set.
# Coins, when SYMBOLS is unset: BTC, ETH, SOL, xyz:GOLD, xyz:SP500, xyz:XYZ100.
# MODEL_B_STYLE=swing
# MODEL_B_PAPER=1
# RISK_PER_TRADE=0.01
# MODEL_B_SWING_CONFIRM=15m
# MODEL_B_SWING_MACRO=4h,1d
# MODEL_B_SWING_MACRO_MODE=both
# MODEL_B_SWING_ATR_TF=1h
# MODEL_B_SWING_ATR_FRAC=0.5
# MODEL_B_SWING_MIN_R=1
# MODEL_B_SWING_MAX_R=5
# MODEL_B_SWING_HOLD_DAYS=3
# MODEL_B_SWING_SLIP_MAIN_BPS=25
# MODEL_B_SWING_SLIP_XYZ_BPS=30
# MODEL_B_SWING_FLOW=tape
# MODEL_B_SWING_RUNNER=0
# Wide reclaim bar and fail-fast scratch stay off. skip drops a reclaim
# bar wider than the bps cap or the ATR multiple. retest waits for price
# to leave the level and trade back to it. Scratch exits at the market
# (taker + slip) if MFE has not reached SCRATCH_MFE_R within
# SCRATCH_MINUTES, or if MAE hits SCRATCH_MAE_R before +0.5R.
# MODEL_B_SWING_RECLAIM_MODE=off
# MODEL_B_SWING_RECLAIM_BPS=0
# MODEL_B_SWING_RECLAIM_ATR=0
# MODEL_B_SWING_SCRATCH_MFE_R=0
# MODEL_B_SWING_SCRATCH_MINUTES=0
# MODEL_B_SWING_SCRATCH_MAE_R=0
# Trapped sellers / trapped buyers. sweep (default) is the reclaim entry.
# trapped reads the footprint: stacked imbalances at a major level, a
# failure bar, then a delta flip. Paper only. The sweep book is unchanged.
# MODEL_B_SWING_ENTRY=sweep
# MODEL_B_SWING_TRAP_BAR=1m
# MODEL_B_SWING_TRAP_IMBALANCE=3
# MODEL_B_SWING_TRAP_STACKED=3
# MODEL_B_SWING_TRAP_ZONE_BPS=20
# MODEL_B_SWING_TRAP_NEAR=0.25
# MODEL_B_SWING_TRAP_MIN_VOL=0
# MODEL_B_SWING_TRAP_STOP_BPS=5
# MODEL_B_SWING_TRAP_ENTRY=failure_close
# MODEL_B_SWING_TRAP_DELTA=either
# MODEL_B_CLOSER_SCORE_GUARD=1 (default) keeps a higher score: resting 9
# is not cancelled for a closer score 4 (CLOSER_SKIP_LOWER_SCORE).
# With MODEL_B_QUALITY_RANK=1 the comparison is setup quality, not the
# 0-9 density score. Equal values still swap on closer bps.
# Set 0 to restore the old cancel.
# Close-margin reserve for a resting unfilled Alo. Highest arm score wins.
# Equal scores keep the coin that already owns the reserve, so a closer
# bps print does not flip BTC/ETH/SOL every few seconds. A strictly higher
# score takes it. A swing that has not armed (NO_SWEEP and the other gates)
# does not hold this reserve and cannot block a setup that cleared every
# gate. 0 turns the reserve off. Not hard-coded to BTC. No new variable:
# free margin also subtracts open-position margin, including xyz dex.
# MODEL_B_CLOSE_MARGIN_RESERVE=0.60
# I_UNDERSTAND_LIVE_TRADING=true
ENTRY_MODE=both
# Model B TP when no swing or pool is in front of the entry.
# Ignored unless ENTRY_MODE=model_b. Clamped to [1, 2]. Default 1.5.
# A liquidity target is used even when it is past 2R.
# MODEL_B_TP_R=1.5
# Volume profile on Model B is journal-only. These stay off; they do not arm or block.
# VP_AS_FILTER=false
# VP_ENTRIES=false
# VP_ENABLED=false
# 90s print floor. Unset: 30 on mainnet, 3 on testnet.
# Testnet 3 = max(3, round(30 * 7/252)).
# 252/min: mainnet BTC trades WS, 2026-10-05 NY (84 prints / 20s).
# 7/min: testnet BTC desk probe the same session (~10.5 prints / 90s).
# MODEL_B_MIN_PRINTS=3
# Maker timer. 0 (default) rests the Alo until the sweep thesis is stale.
# A positive number cancels an unfilled Alo after that many seconds.
# MODEL_B_ALO_TIMEOUT_SEC=0
# Flat delta band. Coin size = max(this / mid, MODEL_B_DELTA_FLAT_EPS).
# Default $100. On SOL that term is wider (~0.67 coins at $150). On BTC
# the 0.05-coin floor below is wider (~$4300 at $86k) and is what is used.
# Long passes at or above −eps coins. Short passes at or below +eps coins.
# 0 drops this term. Both 0 restore the strict sign check.
# MODEL_B_DELTA_FLAT_USDC=100
# Coin-size floor (buy sz − sell sz). The larger of this and the USDC term wins.
# MODEL_B_DELTA_FLAT_EPS=0.05
# Lookback for impulse swing on 1m bars (or HTF if OTE_USE_HTF_SWINGS=true)
OTE_LOOKBACK_BARS=45
# Fibonacci retracement band (shallow=0.62, deep=0.79 → classic OTE)
OTE_FIB_SHALLOW=0.62
OTE_FIB_DEEP=0.79
# Extra buffer beyond zone edge for stop (bps of entry). Stop still clamped
# to STOP_PCT max risk: if zone/swing stop is wider, use STOP_PCT from entry.
OTE_STOP_BUFFER_BPS=0
# Require last 1m close in trade direction (bullish for long / bearish short)
OTE_REQUIRE_CLOSE=false
# Build impulse swings from HTF bars (HTF_INTERVAL) instead of 1m
OTE_USE_HTF_SWINGS=false

# --- Scale-out / sell into strength (paper-first) ---
# At SCALE_OUT_R unrealized R, close SCALE_OUT_PCT of the leg at mark, move
# remaining stop to breakeven ± BE_BUFFER_BPS, leave runner to original TP
# (or RUNNER_TP_R if set). Shorts mirror (cover into weakness).
SCALE_OUT_ENABLED=true
SCALE_OUT_R=1.0
SCALE_OUT_PCT=0.5
BE_BUFFER_BPS=2
# Optional: retarget remainder TP to this R-multiple of original stop distance.
# Empty / unset = keep the original take-profit from entry.
# RUNNER_TP_R=

