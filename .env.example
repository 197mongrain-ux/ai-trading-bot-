# Trading mode: paper (default) | live
TRADING_MODE=paper

# LIVE gate — must be exactly "true" in addition to TRADING_MODE=live
I_UNDERSTAND_LIVE_TRADING=false

# Kill switch: set to 1 to flatten and halt (also works via .killswitch file)
KILL_SWITCH=0

# Hyperliquid network
HL_NETWORK=mainnet
# HL_API_URL=https://api.hyperliquid.xyz
# HL_API_URL=https://api.hyperliquid-testnet.xyz

# API wallet (agent) — NEVER commit real keys
# Create an API wallet at https://app.hyperliquid.xyz/API
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# Symbols — Hyperliquid perp coin names (bare: BTC, SOL, XRP)
# SYMBOLS takes precedence (comma-separated). SYMBOL is single-symbol fallback.
SYMBOLS=BTC,SOL,XRP
# SYMBOL=BTC

# Stacking: max independent opens on the SAME ticker (each with own stop/tp/size).
# Default 3. 0 = unlimited per symbol (still bound by account risk limits).
MAX_POSITIONS_PER_SYMBOL=3

# Optional GLOBAL cap across all symbols / trade_ids. 0 = unlimited (default).
# Example: MAX_OPEN_POSITIONS=9 to allow 3 symbols × 3 stacks.
MAX_OPEN_POSITIONS=0

# Strategy / risk
STARTING_EQUITY=5000
# Scalp default 0.5%. ENTRY_MODE=model_b requires 0.02
# (max 2% of spot USDC, not perp account value).
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.08
# 0 = unlimited daily trade count (default). Set e.g. 500 to hard-cap.
# Strategy signals + daily loss / DD / consecutive-loss still limit activity.
MAX_TRADES_PER_DAY=0
MAX_CONSECUTIVE_LOSSES=3
# Leverage is exchange margin setting (efficiency for tiny stops), NOT position sizing.
# Size always = dollar_risk / stop_distance. Cap notional at equity * LEVERAGE.
LEVERAGE=20
TP_R_MULTIPLE=2.0

# Scalp: fixed % stop from entry (NOT at VWAP). 0.0015 = 0.15%
STOP_PCT=0.0015
# Prior N completed 1m bars for breakout high/low
BREAKOUT_BARS=3
# Optional floor / ceiling on stop distance as fraction of entry
# MIN_STOP_PCT=0
# MAX_STOP_PCT=

# VWAP_BUFFER_BPS is BIAS-ONLY (long if mark > VWAP+buf; short if mark < VWAP-buf).
# Default 0. Optional small buffer e.g. 2 bps. Does NOT place the stop.
VWAP_BUFFER_BPS=0
VWAP_RESET_UTC_HOUR=0
LOOP_INTERVAL_SEC=5
# STOP_BUFFER_BPS is deprecated (old stop-at-VWAP); ignored by strategy
# STOP_BUFFER_BPS=0

# Journal
JOURNAL_PATH=logs/trades.jsonl

# --- Accuracy filters (gate new entries before open) ---
# 1) Volatility / noise vs stop: skip if avg (high-low)/close over lookback
#    >= MAX_RANGE_VS_STOP × STOP_PCT (default 1.0 → bar noise ≥ stop → skip).
MAX_RANGE_VS_STOP=1.0
VOL_LOOKBACK_BARS=5
# Optional: skip if last 1m bar range > this (0.003 = 0.3%). Empty = disable.
MAX_BAR_RANGE_PCT=0.003

# 2) Session / time-of-day (UTC). START-END, start inclusive, end exclusive.
#    12-23 = 12:00–22:59 UTC (liquid crypto hours). Empty or 0-24 = disable.
TRADE_HOURS_UTC=12-23

# 3) Higher-timeframe confirmation: long only above HTF session VWAP, short below.
HTF_CONFIRM=true
HTF_INTERVAL=5m

# After a stop-out on a symbol, block new entries for this many seconds.
ENTRY_COOLDOWN_SEC=120

# Restarting `hl_bot run` always clears in-memory daily halt. Set 1 to also
# journal a risk_reset event at process start.
# RESET_DAILY_RISK=0

# --- Entry mode / OTE pullback add-on ---
# breakout | ote | both (default) | model_b
# both: prefer OTE when mark is in the 62–79% Fib zone of the latest
# impulse (with VWAP bias); else breakout.
# model_b desk start (testnet live). Paper is for unit tests only.
# TRADING_MODE=live
# HL_NETWORK=testnet
# ENTRY_MODE=model_b
# Hunt list. Unset SYMBOLS uses the built-in mainnet universe in both
# NY and after hours (majors first, then xyz:GOLD, xyz:SP500, xyz:XYZ100).
# xyz:XYZ100 is the Nasdaq proxy. The dex prefix stays lowercase.
# SYMBOLS=BTC,ETH,SOL,NEAR,PUMP,LIT,AAVE,ONDO,WLD,TAO,xyz:GOLD,xyz:SP500,xyz:XYZ100
# LEVERAGE=20
# RISK_PER_TRADE=0.02
# HL_ACCOUNT_ADDRESS=0x...   # master account; spot USDC total is the risk base
# Another ticker may rest beside an unfilled Alo when that same balance
# still covers the new ticket's initial margin (notional / the coin's max
# leverage) at full 2% size. Unknown meta uses 20×. LEVERAGE stays 20;
# that env is not the per-coin margin. The exchange leverage set before
# each Alo is still the coin max (margin = notional / coin max).
# MODEL_B_MAX_LEVERAGE is the size brake: ticket notional never exceeds
# that many times spot USDC (default 20; unset / 0 keeps 20).
# MODEL_B_MIN_STOP_BPS (default 15) sizes from at least that stop distance
# when the liquidity stop is tighter. The stop price itself stays put.
# Neither moves the stop, the target, or raises risk above 2%.
# MODEL_B_MAX_LEVERAGE=20
# MODEL_B_MIN_STOP_BPS=15
# A liquidity stop tighter than MODEL_B_MIN_STOP_BPS is moved out to the
# next confirmed swing / untaken pool past that distance (plus the usual
# buffer); TP must then be a pool at >= MODEL_B_TP_R, else STOP_TOO_TIGHT.
# Entry filters: STRUCTURE (no long into 15m/1h LH+LL, no short into HH+HL),
# COUNTER_FLOW (most adverse rolling 90s delta in the last N s, band =
# max(USDC/mid, EPS coins); passes only if flipped >= FLIP x and held),
# SHALLOW_SWEEP (bps past the swing; number or BTC:5,default:0.3).
# MODEL_B_STRUCTURE_FILTER=1
# MODEL_B_COUNTER_FLOW=1
# MODEL_B_COUNTER_FLOW_SEC=300
# MODEL_B_COUNTER_FLOW_USDC=1000000
# MODEL_B_COUNTER_FLOW_EPS=0
# MODEL_B_COUNTER_FLOW_FLIP=1.0
# MODEL_B_COUNTER_FLOW_HOLD_SEC=30
# MODEL_B_MIN_SWEEP_BPS=0.3
# MODEL_B_SWEEP_REQUIRE_HTF=0
# Protection guard (every pass + its own thread): stop on every position
# (two tries, else NAKED_CLOSE), LOSS_KILL at N x planned risk (2% of spot
# if unknown), OVERSIZE_CUT above 20x or N x ticket. Each writes MODEL_B ALERT.
# MODEL_B_GUARD_SEC=3
# MODEL_B_LOSS_KILL_R=1.0
# MODEL_B_OVERSIZE_RATIO=1.1
# Hard rule: no open position may lose more than 2% of the account. Tickets
# are shrunk so loss at the stop <= cap; the guard puts a cap stop on every
# position and LOSS_KILLs at min(LOSS_KILL_R x planned risk, cap x account at
# open). Startup refuses anything above 0.02.
# MODEL_B_MAX_LOSS_PCT=0.02
# If it does not, Model B cancels the resting Alo when the new limit is
# strictly closer to a fill AND the new score is >= the resting score.
# MODEL_B_CLOSER_SCORE_GUARD=1 (default) keeps a higher score: resting 9
# is not cancelled for a closer score 4 (CLOSER_SKIP_LOWER_SCORE).
# Equal scores still swap on closer bps. Set 0 to restore the old cancel.
# Close-margin reserve for a resting unfilled Alo. Highest arm score wins.
# Equal scores keep the coin that already owns the reserve, so a closer
# bps print does not flip BTC/ETH/SOL every few seconds. A strictly higher
# score takes it. A swing that has not armed (NO_SWEEP and the other gates)
# does not hold this reserve and cannot block a setup that cleared every
# gate. 0 turns the reserve off. Not hard-coded to BTC. No new variable:
# free margin also subtracts open-position margin, including xyz dex.
# MODEL_B_CLOSE_MARGIN_RESERVE=0.60
# I_UNDERSTAND_LIVE_TRADING=true
ENTRY_MODE=both
# Model B TP when no swing or pool is in front of the entry.
# Ignored unless ENTRY_MODE=model_b. Clamped to [1, 2]. Default 1.5.
# A liquidity target is used even when it is past 2R.
# MODEL_B_TP_R=1.5
# Volume profile on Model B is journal-only. These stay off; they do not arm or block.
# VP_AS_FILTER=false
# VP_ENTRIES=false
# VP_ENABLED=false
# 90s print floor. Unset: 30 on mainnet, 3 on testnet.
# Testnet 3 = max(3, round(30 * 7/252)).
# 252/min: mainnet BTC trades WS, 2026-10-05 NY (84 prints / 20s).
# 7/min: testnet BTC desk probe the same session (~10.5 prints / 90s).
# MODEL_B_MIN_PRINTS=3
# Maker timer. 0 (default) rests the Alo until the sweep thesis is stale.
# A positive number cancels an unfilled Alo after that many seconds.
# MODEL_B_ALO_TIMEOUT_SEC=0
# Flat delta band. Coin size = max(this / mid, MODEL_B_DELTA_FLAT_EPS).
# Default $100. On SOL that term is wider (~0.67 coins at $150). On BTC
# the 0.05-coin floor below is wider (~$4300 at $86k) and is what is used.
# Long passes at or above −eps coins. Short passes at or below +eps coins.
# 0 drops this term. Both 0 restore the strict sign check.
# MODEL_B_DELTA_FLAT_USDC=100
# Coin-size floor (buy sz − sell sz). The larger of this and the USDC term wins.
# MODEL_B_DELTA_FLAT_EPS=0.05
# Lookback for impulse swing on 1m bars (or HTF if OTE_USE_HTF_SWINGS=true)
OTE_LOOKBACK_BARS=45
# Fibonacci retracement band (shallow=0.62, deep=0.79 → classic OTE)
OTE_FIB_SHALLOW=0.62
OTE_FIB_DEEP=0.79
# Extra buffer beyond zone edge for stop (bps of entry). Stop still clamped
# to STOP_PCT max risk: if zone/swing stop is wider, use STOP_PCT from entry.
OTE_STOP_BUFFER_BPS=0
# Require last 1m close in trade direction (bullish for long / bearish short)
OTE_REQUIRE_CLOSE=false
# Build impulse swings from HTF bars (HTF_INTERVAL) instead of 1m
OTE_USE_HTF_SWINGS=false

# --- Scale-out / sell into strength (paper-first) ---
# At SCALE_OUT_R unrealized R, close SCALE_OUT_PCT of the leg at mark, move
# remaining stop to breakeven ± BE_BUFFER_BPS, leave runner to original TP
# (or RUNNER_TP_R if set). Shorts mirror (cover into weakness).
SCALE_OUT_ENABLED=true
SCALE_OUT_R=1.0
SCALE_OUT_PCT=0.5
BE_BUFFER_BPS=2
# Optional: retarget remainder TP to this R-multiple of original stop distance.
# Empty / unset = keep the original take-profit from entry.
# RUNNER_TP_R=

