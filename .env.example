# Trading mode: paper (default) | live
TRADING_MODE=paper

# LIVE gate — must be exactly "true" in addition to TRADING_MODE=live
I_UNDERSTAND_LIVE_TRADING=false

# Kill switch: set to 1 to flatten and halt (also works via .killswitch file)
KILL_SWITCH=0

# Hyperliquid network
HL_NETWORK=mainnet
# HL_API_URL=https://api.hyperliquid.xyz
# HL_API_URL=https://api.hyperliquid-testnet.xyz

# API wallet (agent) — NEVER commit real keys
# Create an API wallet at https://app.hyperliquid.xyz/API
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# Symbols — Hyperliquid perp coin names (bare: BTC, SOL, XRP)
# SYMBOLS takes precedence (comma-separated). SYMBOL is single-symbol fallback.
SYMBOLS=BTC,SOL,XRP
# SYMBOL=BTC

# Stacking: max independent opens on the SAME ticker (each with own stop/tp/size).
# Default 3. 0 = unlimited per symbol (still bound by account risk limits).
MAX_POSITIONS_PER_SYMBOL=3

# Optional GLOBAL cap across all symbols / trade_ids. 0 = unlimited (default).
# Example: MAX_OPEN_POSITIONS=9 to allow 3 symbols × 3 stacks.
MAX_OPEN_POSITIONS=0

# Strategy / risk
STARTING_EQUITY=5000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.08
# 0 = unlimited daily trade count (default). Set e.g. 500 to hard-cap.
# Strategy signals + daily loss / DD / consecutive-loss still limit activity.
MAX_TRADES_PER_DAY=0
MAX_CONSECUTIVE_LOSSES=3
# Leverage is exchange margin setting (efficiency for tiny stops), NOT position sizing.
# Size always = dollar_risk / stop_distance. Cap notional at equity * LEVERAGE.
LEVERAGE=20
TP_R_MULTIPLE=2.0

# Scalp: fixed % stop from entry (NOT at VWAP). 0.0015 = 0.15%
STOP_PCT=0.0015
# Prior N completed 1m bars for breakout high/low
BREAKOUT_BARS=3
# Optional floor / ceiling on stop distance as fraction of entry
# MIN_STOP_PCT=0
# MAX_STOP_PCT=

# VWAP_BUFFER_BPS is BIAS-ONLY (long if mark > VWAP+buf; short if mark < VWAP-buf).
# Default 0. Optional small buffer e.g. 2 bps. Does NOT place the stop.
VWAP_BUFFER_BPS=0
VWAP_RESET_UTC_HOUR=0
LOOP_INTERVAL_SEC=5
# STOP_BUFFER_BPS is deprecated (old stop-at-VWAP); ignored by strategy
# STOP_BUFFER_BPS=0

# Journal
JOURNAL_PATH=logs/trades.jsonl

# --- Accuracy filters (gate new entries before open) ---
# 1) Volatility / noise vs stop: skip if avg (high-low)/close over lookback
#    >= MAX_RANGE_VS_STOP × STOP_PCT (default 1.0 → bar noise ≥ stop → skip).
MAX_RANGE_VS_STOP=1.0
VOL_LOOKBACK_BARS=5
# Optional: skip if last 1m bar range > this (0.003 = 0.3%). Empty = disable.
MAX_BAR_RANGE_PCT=0.003

# 2) Session / time-of-day (UTC). START-END, start inclusive, end exclusive.
#    12-23 = 12:00–22:59 UTC (liquid crypto hours). Empty or 0-24 = disable.
TRADE_HOURS_UTC=12-23

# 3) Higher-timeframe confirmation: long only above HTF session VWAP, short below.
HTF_CONFIRM=true
HTF_INTERVAL=5m

# After a stop-out on a symbol, block new entries for this many seconds.
ENTRY_COOLDOWN_SEC=120

# Restarting `hl_bot run` always clears in-memory daily halt. Set 1 to also
# journal a risk_reset event at process start.
# RESET_DAILY_RISK=0

# --- Entry mode / OTE pullback add-on ---
# breakout | ote | both (default). both: prefer OTE when mark is in the
# 62–79% Fib zone of the latest impulse (with VWAP bias); else breakout.
ENTRY_MODE=both
# Lookback for impulse swing on 1m bars (or HTF if OTE_USE_HTF_SWINGS=true)
OTE_LOOKBACK_BARS=45
# Fibonacci retracement band (shallow=0.62, deep=0.79 → classic OTE)
OTE_FIB_SHALLOW=0.62
OTE_FIB_DEEP=0.79
# Extra buffer beyond zone edge for stop (bps of entry). Stop still clamped
# to STOP_PCT max risk: if zone/swing stop is wider, use STOP_PCT from entry.
OTE_STOP_BUFFER_BPS=0
# Require last 1m close in trade direction (bullish for long / bearish short)
OTE_REQUIRE_CLOSE=false
# Build impulse swings from HTF bars (HTF_INTERVAL) instead of 1m
OTE_USE_HTF_SWINGS=false

# --- Scale-out / sell into strength (paper-first) ---
# At SCALE_OUT_R unrealized R, close SCALE_OUT_PCT of the leg at mark, move
# remaining stop to breakeven ± BE_BUFFER_BPS, leave runner to original TP
# (or RUNNER_TP_R if set). Shorts mirror (cover into weakness).
SCALE_OUT_ENABLED=true
SCALE_OUT_R=1.0
SCALE_OUT_PCT=0.5
BE_BUFFER_BPS=2
# Optional: retarget remainder TP to this R-multiple of original stop distance.
# Empty / unset = keep the original take-profit from entry.
# RUNNER_TP_R=

